// Settings Cloudflare reads when it publishes the site.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "dave-o-portfolio",
  "compatibility_date": "2026-10-01",

  // The web addresses the site answers on. Cloudflare creates the address records
  // and the security certificate for each one automatically.
  "routes": [
    { "pattern": "davidokunlola.com", "custom_domain": true },
    { "pattern": "www.davidokunlola.com", "custom_domain": true }
  ],

  // Before publishing (and when previewing), put the website together from "site-source".
  // This means Cloudflare needs no extra build setting in its dashboard.
  "build": {
    "command": "node build-website.js",
    "watch_dir": "site-source"
  },

  // The small amount of code that runs on Cloudflare: the password lock and the note wall.
  "main": "cloudflare-worker/worker.js",

  // The finished website (made by the build step above) that Cloudflare serves as plain files.
  "assets": {
    "directory": "./site-output",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these addresses go through the code above; everything else is served directly.
    "run_worker_first": ["/work/confidential-project", "/work/confidential-project/*", "/api/*"]
  },

  // The database that stores notes left on the About page.
  // There is no ID here on purpose: Cloudflare creates the database the first time the site is published.
  "d1_databases": [
    {
      "binding": "NOTES_DB",
      "database_name": "david-okunlola-portfolio-notes"
    }
  ]
}
